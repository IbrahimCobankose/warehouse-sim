#!/bin/sh
#
# @name Gazebo warehouse scout (x500, 3 kamera)
#
# @type Quadrotor
#
# Depo envanter drone'u. Gövde ve motor konfigürasyonu 4001_gz_x500 ile
# aynı; buradaki fark kapalı ve dar bir ortam için daraltılmış hız/eğim
# limitleri. Raf koridorları 3 m genişliğinde, varsayılan 12 m/s'lik yatay
# hız limiti bu ortamda anlamsız ve tehlikeli.
#
# Model adı "x500_warehouse" DEĞİL: PX4'ün gz make hedefleri
# gz_<model>_<world> biçiminde olduğu için o ad "x500" + "warehouse" ile
# çakışıyor ve CMake configure aşamasında düşüyor.
#

PX4_SIM_MODEL=${PX4_SIM_MODEL:=warehouse_scout}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=warehouse}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# --- kapalı ortam uçuş zarfı ---
param set-default MPC_XY_VEL_MAX 3.0
param set-default MPC_XY_VEL_ALL 1.5
param set-default MPC_Z_VEL_MAX_UP 1.5
param set-default MPC_Z_VEL_MAX_DN 1.0
param set-default MPC_TILTMAX_AIR 25.0

# Raf gözlerinin ikinci seviyesi 1.85 m'de; kalkış irtifası oraya yakın
# olsun ki araç havalanır havalanmaz tarama yüksekliğinde olsun.
param set-default MIS_TAKEOFF_ALT 1.5

# 3 kamera toplam 90 g ekliyor (~%4.5). Hover thrust kestiricisi bunu
# uçuşta kapatıyor, yine de başlangıç değerini biraz yukarı alalım.
param set-default MPC_THR_HOVER 0.62

# 4001_gz_x500 bunu 2 (veri bağı kaybında RTL) yapıyor; o da "yer istasyonuna
# bağlantı yok" ön uçuş kontrolünü zorunlu kılıp arm'ı engelliyor. Kapalı
# ortamda görev bilgisayarı araç üzerinde ve telemetri linki yok -- gerçek
# donanımda da bu konfigürasyon normaldir.
param set-default NAV_DLL_ACT 0

# --- GPS'siz uçuş: optik akış + mesafe ölçer (yol haritası 2. aşama) ---
# Kapalı depoda GPS yok. Referans: 4021_gz_x500_flow (o sadece GPS'i
# kapatıyor, gerisi PX4 varsayılanlarıyla geliyor); buradaki ekler kapalı
# ortama özgü.
param set-default SYS_HAS_GPS 0
param set-default SIM_GPS_USED 0
param set-default EKF2_GPS_CTRL 0

# Akış füzyonu (EKF2_OF_CTRL) PX4'te zaten varsayılan olarak açık; burada
# yalnızca sensörün gövdedeki yeri veriliyor. Gövde ekseni FRD: z AŞAĞI
# pozitif, SDF'deki -0.10 burada +0.10 olur.
param set-default EKF2_OF_POS_X 0.03
param set-default EKF2_OF_POS_Y 0.0
param set-default EKF2_OF_POS_Z 0.10
param set-default EKF2_RNG_POS_X 0.0
param set-default EKF2_RNG_POS_Y 0.0
param set-default EKF2_RNG_POS_Z 0.05

# Yükseklik referansı barometre değil mesafe ölçer: depo zemini düz beton,
# barometre ise kapalı ortamda pervane basıncından etkileniyor. Bu seçim
# ancak DÜZ zeminde geçerli -- rafın üstünden geçilirse yerel origin
# zıplar; rota zemin üstünde kalacak şekilde kurulmalı.
param set-default EKF2_HGT_REF 2
# 2 = her zaman aç. Varsayılan 1 "koşullu" mod: yalnızca düşük hız ve
# EKF2_RNG_A_HMAX (5 m) altında kullanır. Bizde tavan yüksekliği zaten 4 m
# civarı ve mesafe ölçerin sürekli devrede olmasını istiyoruz.
param set-default EKF2_RNG_CTRL 2

# --- AprilTag ile mutlak düzeltme (yol haritası 3. aşama) ---
# scripts/apriltag_localize.py zemin markörlerinden poz kestirip
# VISION_POSITION_ESTIMATE olarak yolluyor.
#
# EKF2_EV_CTRL bit maskesi: 1=yatay konum, 2=dikey konum, 4=hız, 8=yaw.
# 9 = yatay konum + yaw. Dikey KASITLI olarak dışarıda: yükseklik referansı
# mesafe ölçer (EKF2_HGT_REF 2) ve iki kaynağı aynı anda karıştırmak,
# markör görünürken/kaybolurken origin zıplatıyor. Dikey kestirimdeki
# 0.375 m'lik sapma bu yüzden 3. aşamada kapanmıyor -- ayrı iş.
param set-default EKF2_EV_CTRL 9

# Kamera 20 Hz + ROS köprüsü + tespit: kabaca 50 ms gecikme. Ölçülmedi,
# makul bir başlangıç; kestirim titrerse önce buraya bakın.
param set-default EKF2_EV_DELAY 50.0

# Gürültüyü mesajdan değil parametreden al (1). VISION_POSITION_ESTIMATE'in
# kovaryans alanını doldurmuyoruz, mesaja güvenmek sıfır kovaryans demek
# olurdu -- EKF ölçümü mutlak doğru sanıp diğer kaynakları ezerdi.
param set-default EKF2_EV_NOISE_MD 1
param set-default EKF2_EVP_NOISE 0.05
param set-default EKF2_EVA_NOISE 0.05
